# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=water_meter_db
DB_USER=root
DB_PASSWORD=123456

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# InfluxDB配置
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=water-meter-token
INFLUXDB_ORG=water-org
INFLUXDB_BUCKET=water_usage

# Kafka配置
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=agent-engine

# AI模型配置
OCR_MODEL_DIR=./models/ocr
ANOMALY_MODEL_DIR=./models/anomaly
FORECAST_MODEL_DIR=./models/forecast

# 智能体配置
AGENT_CONFIDENCE_THRESHOLD=0.95
ANOMALY_ALERT_THRESHOLD=0.8
COLLECTION_SCHEDULE_CRON=0 0 8 * * ?

# Flask配置
FLASK_HOST=0.0.0.0
FLASK_PORT=8087
FLASK_DEBUG=True
SECRET_KEY=water-meter-agent-secret-key-2024
